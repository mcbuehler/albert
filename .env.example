# Required by /api/health. Copy the transaction pooler URL from Supabase and URL-encode its password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Generate distinct random secrets for the Vapi webhook and the cron endpoints.
REL8_API_AUTH_TOKEN="VAPI_WEBHOOK_TOKEN"
CRON_SECRET="CRON_TOKEN"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_TOKEN"
# Backend-only key for the private call-recordings bucket.
SUPABASE_SECRET_KEY="sb_secret_TOKEN"
VAPI_API_KEY="TOKEN"
VAPI_ASSISTANT_ID="UUID"
HINDSIGHT_API_KEY="hsk_TOKEN"
BRAVE_API_KEY="TOKEN"

# Optional: only legacy Supabase projects that sign JWTs with HS256
# SUPABASE_JWT_SECRET="TOKEN"

# Optional country-specific assistants for unknown inbound callers.
# The US values also apply to Canada; VAPI_ASSISTANT_ID is the fallback.
# VAPI_INBOUND_ASSISTANT_ID_US="UUID"
# VAPI_INBOUND_ASSISTANT_ID_CH="UUID"

# Required to enable inbound sign-up in the US/Canada and Switzerland.
# VAPI_ASSISTANT_ID_US="UUID"
# VAPI_PHONE_NUMBER_ID_US="UUID"
# VAPI_ASSISTANT_ID_CH="UUID"
# VAPI_PHONE_NUMBER_ID_CH="UUID"

# Required to deliver stored team notifications through Google Workspace SMTP.
# SMTP_USER="albert@example.com"
# SMTP_PASSWORD="GOOGLE_APP_PASSWORD"
# TEAM_EMAIL="team@example.com"

# Optional monitoring and local logging
# HEALTHCHECKS_PING_URL="https://hc-ping.com/UUID"
# LOCAL_LOGGING="1"
# LOG_STDOUT="1"

# Local database integration tests only; must point to localhost.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/albert_test"
